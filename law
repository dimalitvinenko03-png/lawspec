<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Юридичний Спектр — Запис на консультацію</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:       #0b1422;
      --navy-card:  #111e30;
      --navy-line:  #162034;
      --gold:       #c8973a;
      --gold-light: #dea94a;
      --gold-dim:   rgba(200,151,58,.35);
      --text:       #cdd5e0;
      --text-dim:   #7a8ea6;
      --white:      #f0f4fa;
      --radius:     4px;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--navy);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ─── HEADER ─────────────────────────── */
    header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 200;
      height: 64px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 40px;
      background: rgba(11,20,34,.96);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--gold-dim);
    }
    .h-logo { display: flex; align-items: center; gap: 11px; text-decoration: none; }
    .h-logo img { height: 40px; width: 40px; object-fit: contain; }
    .h-logo-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.05rem; font-weight: 700; color: var(--gold-light);
      line-height: 1.25;
    }
    .h-logo-text small {
      display: block; font-family: 'Inter', sans-serif;
      font-size: .62rem; font-weight: 400; letter-spacing: .14em;
      text-transform: uppercase; color: var(--text-dim);
    }
    .h-nav { display: flex; align-items: center; gap: 6px; }
    .h-nav-link {
      font-size: .78rem; font-weight: 500; color: var(--text-dim);
      text-decoration: none; letter-spacing: .04em;
      padding: 6px 12px; border-radius: var(--radius);
      transition: color .2s, background .2s;
    }
    .h-nav-link:hover { color: var(--gold-light); background: rgba(200,151,58,.08); }
    .h-right { display: flex; align-items: center; gap: 16px; }
    .h-phone {
      font-size: .82rem; font-weight: 500; color: var(--gold-light);
      text-decoration: none; letter-spacing: .02em;
      display: flex; align-items: center; gap: 6px;
    }
    .h-phone svg { width: 13px; height: 13px; flex-shrink: 0; }
    .h-phone:hover { color: var(--white); }
    .h-cta {
      font-size: .78rem; font-weight: 600; letter-spacing: .05em;
      padding: 8px 20px; border-radius: var(--radius);
      background: var(--gold); color: var(--navy);
      text-decoration: none; border: none; cursor: pointer;
      transition: background .2s;
    }
    .h-cta:hover { background: var(--gold-light); }

    /* ─── HERO ───────────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      padding-top: 64px;
      position: relative;
      overflow: hidden;
    }
    /* dark textured bg */
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background:
        linear-gradient(135deg, rgba(200,151,58,.07) 0%, transparent 55%),
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 60px,
          rgba(200,151,58,.025) 60px,
          rgba(200,151,58,.025) 61px
        ),
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 60px,
          rgba(200,151,58,.025) 60px,
          rgba(200,151,58,.025) 61px
        );
      pointer-events: none;
    }
    .hero-left {
      padding: 80px 60px 80px 60px;
      display: flex; flex-direction: column; justify-content: center;
      position: relative; z-index: 1;
    }
    .hero-eyebrow {
      font-size: .7rem; letter-spacing: .22em; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin-bottom: 20px;
      display: flex; align-items: center; gap: 10px;
    }
    .hero-eyebrow::before {
      content: ''; display: inline-block;
      width: 32px; height: 1px; background: var(--gold);
    }
    .hero h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.8rem, 5.5vw, 5rem);
      font-weight: 700; line-height: 1.05;
      color: var(--white); margin-bottom: 8px;
      letter-spacing: -.01em;
    }
    .hero h1 .accent {
      color: var(--gold-light);
      display: block;
    }
    .hero-sub {
      font-size: .95rem; line-height: 1.7; color: var(--text-dim);
      max-width: 440px; margin: 24px 0 40px;
    }
    .hero-contacts {
      display: flex; flex-direction: column; gap: 10px; margin-bottom: 40px;
    }
    .hero-contact-item {
      display: flex; align-items: center; gap: 10px;
      font-size: .88rem; color: var(--text);
    }
    .hero-contact-item svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--gold); }
    .hero-contact-item a { color: var(--gold-light); text-decoration: none; }
    .hero-contact-item a:hover { color: var(--white); }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
    .btn-primary {
      padding: 14px 32px; background: var(--gold); color: var(--navy);
      font-size: .88rem; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; border-radius: var(--radius);
      text-decoration: none; border: none; cursor: pointer;
      transition: background .2s, transform .15s;
    }
    .btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); }
    .btn-outline {
      padding: 14px 32px;
      border: 1px solid var(--gold-dim); color: var(--gold-light);
      font-size: .88rem; font-weight: 600; letter-spacing: .04em;
      border-radius: var(--radius); text-decoration: none;
      transition: border-color .2s, color .2s;
    }
    .btn-outline:hover { border-color: var(--gold); color: var(--white); }

    /* hero right — services list panel */
    .hero-right {
      background: var(--navy-card);
      border-left: 1px solid var(--gold-dim);
      display: flex; flex-direction: column; justify-content: center;
      padding: 80px 44px;
      position: relative; z-index: 1;
    }
    .hero-right-label {
      font-size: .65rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--text-dim); margin-bottom: 28px;
    }
    .hero-services-list { list-style: none; display: flex; flex-direction: column; gap: 4px; }
    .hero-services-list li {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 16px; border-radius: var(--radius);
      cursor: default;
      transition: background .2s;
    }
    .hero-services-list li:hover { background: rgba(200,151,58,.08); }
    .hs-icon {
      width: 40px; height: 40px; flex-shrink: 0;
      background: rgba(200,151,58,.12);
      border: 1px solid var(--gold-dim);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
    }
    .hs-text strong {
      display: block; font-size: .88rem; font-weight: 600;
      color: var(--white); line-height: 1.3;
    }
    .hs-text span { font-size: .75rem; color: var(--text-dim); }

    /* ─── SECTION COMMONS ─────────────────── */
    .section { padding: 90px 60px; }
    .section-inner { max-width: 1100px; margin: 0 auto; }
    .sec-label {
      font-size: .68rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--gold); font-weight: 500; margin-bottom: 10px;
      display: flex; align-items: center; gap: 10px;
    }
    .sec-label::before {
      content: ''; display: inline-block;
      width: 28px; height: 1px; background: var(--gold);
    }
    .sec-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 4vw, 3rem); font-weight: 700;
      color: var(--white); line-height: 1.1; margin-bottom: 52px;
    }
    .gold-rule {
      width: 44px; height: 2px; background: var(--gold);
      margin: 12px 0 48px;
    }

    /* ─── ABOUT / PRACTICE AREAS ─────────── */
    .areas { background: var(--navy-line); }
    .areas-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }
    .area-card {
      background: var(--navy-card);
      padding: 36px 28px;
      border-top: 2px solid transparent;
      transition: border-color .25s, background .25s;
      position: relative; overflow: hidden;
    }
    .area-card::after {
      content: '';
      position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
      background: var(--gold-dim);
    }
    .area-card:hover {
      border-top-color: var(--gold);
      background: rgba(200,151,58,.05);
    }
    .area-num {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3.5rem; font-weight: 700;
      color: rgba(200,151,58,.12); line-height: 1;
      position: absolute; top: 16px; right: 20px;
    }
    .area-icon { font-size: 1.6rem; margin-bottom: 16px; }
    .area-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem; font-weight: 700;
      color: var(--gold-light); margin-bottom: 10px;
    }
    .area-card p { font-size: .82rem; color: var(--text-dim); line-height: 1.65; }

    /* ─── CONTACT INFO STRIP ──────────────── */
    .contact-strip {
      background: var(--navy-card);
      border-top: 1px solid var(--gold-dim);
      border-bottom: 1px solid var(--gold-dim);
      padding: 0 60px;
    }
    .contact-strip-inner {
      max-width: 1100px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(3, 1fr);
      divide: yes;
    }
    .cs-item {
      display: flex; align-items: center; gap: 18px;
      padding: 36px 24px;
      border-right: 1px solid var(--gold-dim);
    }
    .cs-item:last-child { border-right: none; }
    .cs-ico {
      width: 48px; height: 48px; flex-shrink: 0;
      background: rgba(200,151,58,.1);
      border: 1px solid var(--gold-dim);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
    }
    .cs-ico svg { width: 20px; height: 20px; color: var(--gold); }
    .cs-body label {
      display: block; font-size: .65rem; letter-spacing: .15em;
      text-transform: uppercase; color: var(--text-dim); margin-bottom: 5px;
    }
    .cs-body a, .cs-body p {
      font-size: .95rem; font-weight: 600; color: var(--white);
      text-decoration: none; margin: 0;
    }
    .cs-body a:hover { color: var(--gold-light); }
    .cs-body small { display: block; font-size: .75rem; color: var(--text-dim); margin-top: 2px; }

    /* ─── FORM ────────────────────────────── */
    .form-section { background: var(--navy); }
    .form-layout {
      display: grid; grid-template-columns: 1fr 520px; gap: 64px;
      align-items: start;
    }
    .form-intro {}
    .form-intro p { font-size: .9rem; color: var(--text-dim); line-height: 1.75; margin-bottom: 32px; }
    .form-perks { list-style: none; display: flex; flex-direction: column; gap: 14px; }
    .form-perks li {
      display: flex; align-items: flex-start; gap: 12px;
      font-size: .85rem; color: var(--text-dim); line-height: 1.5;
    }
    .form-perks li::before {
      content: ''; flex-shrink: 0; margin-top: 6px;
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--gold);
    }
    .form-perks li strong { color: var(--white); }

    .form-box {
      background: var(--navy-card);
      border: 1px solid var(--gold-dim);
      border-radius: 8px;
      padding: 44px 40px;
    }
    .form-box h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.6rem; font-weight: 700; color: var(--white);
      margin-bottom: 4px;
    }
    .form-box > p { font-size: .8rem; color: var(--text-dim); margin-bottom: 28px; }

    .fg { margin-bottom: 18px; }
    .fg label {
      display: block; font-size: .7rem; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 7px;
    }
    .fg input, .fg select, .fg textarea {
      width: 100%;
      background: rgba(255,255,255,.04);
      border: 1px solid rgba(200,151,58,.22);
      border-radius: var(--radius);
      color: var(--white); font-family: 'Inter', sans-serif;
      font-size: .88rem; padding: 11px 14px;
      outline: none; appearance: none;
      transition: border-color .2s, background .2s;
    }
    .fg input::placeholder, .fg textarea::placeholder { color: rgba(120,140,165,.5); }
    .fg input:focus, .fg select:focus, .fg textarea:focus {
      border-color: var(--gold); background: rgba(200,151,58,.05);
    }
    .fg select { cursor: pointer; }
    .fg select option { background: #111e30; color: #fff; }
    .fg textarea { resize: vertical; min-height: 88px; }

    .sel-wrap { position: relative; }
    .sel-wrap::after {
      content: '▾'; position: absolute; right: 12px; top: 50%;
      transform: translateY(-50%); color: var(--gold);
      pointer-events: none; font-size: .85rem;
    }

    .fg-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

    /* THE FIX: hidden by default via CSS class */
    .fg-hidden { display: none; }
    .fg-visible { display: block; }

    .submit-btn {
      width: 100%; padding: 13px;
      background: var(--gold); color: var(--navy);
      font-family: 'Inter', sans-serif; font-size: .85rem;
      font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      border: none; border-radius: var(--radius); cursor: pointer;
      margin-top: 6px;
      transition: background .2s, transform .15s;
    }
    .submit-btn:hover { background: var(--gold-light); transform: translateY(-1px); }
    .submit-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
    .form-note { text-align: center; font-size: .72rem; color: var(--text-dim); margin-top: 12px; }

    .toast {
      display: none; align-items: center; gap: 10px;
      padding: 12px 16px; border-radius: var(--radius);
      margin-top: 16px; font-size: .85rem; font-weight: 500;
    }
    .toast.success { background: rgba(72,199,142,.1); border: 1px solid rgba(72,199,142,.4); color: #48c78e; }
    .toast.error   { background: rgba(241,70,104,.1); border: 1px solid rgba(241,70,104,.4); color: #f14668; }
    .toast.show    { display: flex; }

    /* ─── FOOTER ──────────────────────────── */
    footer {
      background: var(--navy-card);
      border-top: 1px solid var(--gold-dim);
      padding: 48px 60px 32px;
    }
    .footer-inner {
      max-width: 1100px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr auto; gap: 40px;
      align-items: start; padding-bottom: 36px;
      border-bottom: 1px solid rgba(200,151,58,.12);
      margin-bottom: 28px;
    }
    .footer-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .footer-brand img { height: 38px; width: 38px; object-fit: contain; }
    .footer-brand-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem; font-weight: 700; color: var(--gold-light);
    }
    .footer-tagline { font-size: .8rem; color: var(--text-dim); max-width: 300px; line-height: 1.6; }

    .social-links { display: flex; gap: 10px; flex-wrap: wrap; }
    .sl {
      width: 40px; height: 40px;
      border: 1px solid var(--gold-dim);
      border-radius: var(--radius);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-dim); text-decoration: none;
      transition: border-color .2s, color .2s, background .2s;
    }
    .sl:hover { border-color: var(--gold); color: var(--gold-light); background: rgba(200,151,58,.08); }
    .sl svg { width: 16px; height: 16px; }
    .footer-copy {
      max-width: 1100px; margin: 0 auto;
      font-size: .72rem; color: var(--text-dim);
    }

    /* ─── RESPONSIVE ──────────────────────── */
    @media (max-width: 1024px) {
      .hero { grid-template-columns: 1fr; }
      .areas-grid { grid-template-columns: repeat(2, 1fr); }
      .form-layout { grid-template-columns: 1fr; gap: 40px; }
      .contact-strip-inner { grid-template-columns: 1fr; }
      .cs-item { border-right: none; border-bottom: 1px solid var(--gold-dim); }
      .cs-item:last-child { border-bottom: none; }
      .footer-inner { grid-template-columns: 1fr; }
    }
    @media (max-width: 680px) {
      header { padding: 0 20px; }
      .h-right .h-phone { display: none; }
      .h-nav { display: none; }
      .hero-left { padding: 60px 24px; }
      .section { padding: 64px 24px; }
      .areas-grid { grid-template-columns: 1fr; }
      .form-box { padding: 28px 22px; }
      .fg-row { grid-template-columns: 1fr; }
      .contact-strip { padding: 0 24px; }
      footer { padding: 40px 24px 28px; }
    }
  </style>
</head>
<body>

