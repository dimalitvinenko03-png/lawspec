<script>
  /* ── Плавний скрол до форми ─────────────────────────── */
  document.querySelectorAll('.scroll-to, a[href="#form"], a[href="#areas"]').forEach(link => {
    link.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        const offset = 72; // висота хедера
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });

  /* ── Supabase config ── замініть на свої дані ─────────── */
  const SUPABASE_URL     = 'https://syfmpggitntlmwfyjfql.supabase.co';
  const SUPABASE_ANON_KEY = 'sb_publishable_9i4mi3G--y6H09zoAk-JjA_tArzmNMN';
  const TABLE_NAME       = 'consultations';
  /* ──────────────────────────────────────────────────────── */

  /* Мінімальна дата — сьогодні */
  const dateInput = document.getElementById('date');
  dateInput.min = new Date().toISOString().split('T')[0];

  /* Показ/приховання поля "Інше" */
  const typeSelect    = document.getElementById('consultation_type');
  const otherGroup    = document.getElementById('other-type-group');
  const otherTextarea = document.getElementById('other_type');

  typeSelect.addEventListener('change', function () {
    if (this.value === 'Інше') {
      otherGroup.classList.remove('fg-hidden');
      otherGroup.classList.add('fg-visible');
      otherTextarea.required = true;
    } else {
      otherGroup.classList.remove('fg-visible');
      otherGroup.classList.add('fg-hidden');
      otherTextarea.required = false;
      otherTextarea.value = '';
    }
  });

  /* Форматування телефону */
  document.getElementById('phone').addEventListener('blur', function () {
    const d = this.value.replace(/\D/g, '');
    if (d.startsWith('380'))   this.value = '+' + d;
    else if (d.startsWith('0')) this.value = '+38' + d;
  });

  /* Відправка */
  const form      = document.getElementById('consultationForm');
  const submitBtn = document.getElementById('submitBtn');
  const toastOk   = document.getElementById('toastSuccess');
  const toastErr  = document.getElementById('toastError');
  const errMsg    = document.getElementById('errorMsg');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    toastOk.classList.remove('show');
    toastErr.classList.remove('show');

    const name  = document.getElementById('name').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const date  = dateInput.value;
    const type  = typeSelect.value;
    const other = otherTextarea.value.trim();

    if (!name || !phone || !date || !type) {
      errMsg.textContent = "Будь ласка, заповніть усі обов'язкові поля.";
      toastErr.classList.add('show');
      return;
    }
    if (type === 'Інше' && !other) {
      errMsg.textContent = 'Будь ласка, опишіть ваше питання у полі нижче.';
      toastErr.classList.add('show');
      return;
    }

    const finalType = type === 'Інше' ? ('Інше: ' + other) : type;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Надсилаємо…';

    try {
      const res = await fetch(SUPABASE_URL + '/rest/v1/' + TABLE_NAME, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify({
          name,
          phone,
          consultation_date: date,
          consultation_type: finalType,
          created_at: new Date().toISOString()
        })
      });

      if (res.ok || res.status === 201) {
        toastOk.classList.add('show');
        form.reset();
        typeSelect.value = '';
        otherGroup.classList.remove('fg-visible');
        otherGroup.classList.add('fg-hidden');
        otherTextarea.required = false;
      } else {
        const d = await res.json().catch(() => ({}));
        errMsg.textContent = d.message || ('Помилка сервера (' + res.status + '). Спробуйте пізніше.');
        toastErr.classList.add('show');
      }
    } catch (err) {
      errMsg.textContent = "Немає з'єднання. Перевірте інтернет і спробуйте ще раз.";
      toastErr.classList.add('show');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Надіслати заявку';
    }
  });
</script>

